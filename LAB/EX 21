def text_justification(words, max_width):
    n = len(words)
    dp = [float("inf")] * (n + 1)
    parent = [-1] * (n + 1)
    dp[0] = 0

    for i in range(1, n + 1):
        line_length = 0

        for j in range(i, 0, -1):
            line_length += len(words[j - 1])

            if j < i:
                line_length += 1  # space between words

            if line_length > max_width:
                break

            extra_spaces = max_width - line_length
            cost = 0 if i == n else extra_spaces ** 2

            if dp[j - 1] + cost < dp[i]:
                dp[i] = dp[j - 1] + cost
                parent[i] = j - 1

    lines = []
    index = n

    while index > 0:
        start = parent[index]
        lines.append(" ".join(words[start:index]))
        index = start

    return lines[::-1]


words = ["This", "is", "an", "example", "of", "text", "justification"]
max_width = 10

for line in text_justification(words, max_width):
    print(line)

