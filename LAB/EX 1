def bubble_sort(numbers):
    n = len(numbers)

    for i in range(n):
        swapped = False

        for j in range(n - 1 - i):
            if numbers[j] > numbers[j + 1]:
                numbers[j], numbers[j + 1] = numbers[j + 1], numbers[j]
                swapped = True

        if not swapped:
            break

    return numbers


values = [64, 34, 25, 12, 22, 11, 90]
print(bubble_sort(values))

OUTPUT:
[11, 12, 22, 25, 34, 64, 90]
