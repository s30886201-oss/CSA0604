def optimal_bst(keys, frequency):
    n = len(keys)
    cost = [[0] * n for _ in range(n)]

    for i in range(n):
        cost[i][i] = frequency[i]

    for length in range(2, n + 1):
        for i in range(n - length + 1):
            j = i + length - 1
            cost[i][j] = float("inf")

            total_frequency = sum(frequency[i:j + 1])

            for root in range(i, j + 1):
                left_cost = cost[i][root - 1] if root > i else 0
                right_cost = cost[root + 1][j] if root < j else 0

                cost[i][j] = min(
                    cost[i][j],
                    left_cost + right_cost + total_frequency
                )

    return cost[0][n - 1]


keys = [10, 12, 20]
frequency = [34, 8, 50]

print("Minimum search cost:", optimal_bst(keys, frequency))

