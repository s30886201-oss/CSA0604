from itertools import permutations

def travelling_salesman(graph, start=0):
    cities = list(range(len(graph)))
    other_cities = [city for city in cities if city != start]

    minimum_cost = float("inf")
    best_path = []

    for order in permutations(other_cities):
        path = (start,) + order + (start,)
        cost = sum(graph[path[i]][path[i + 1]] for i in range(len(path) - 1))

        if cost < minimum_cost:
            minimum_cost = cost
            best_path = path

    return minimum_cost, best_path


graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

cost, path = travelling_salesman(graph)

print("Minimum cost:", cost)
print("Best path:", path)

