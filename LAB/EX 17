def word_break(text, dictionary):
    word_set = set(dictionary)
    n = len(text)
    dp = [False] * (n + 1)
    dp[0] = True

    for i in range(1, n + 1):
        for j in range(i):
            if dp[j] and text[j:i] in word_set:
                dp[i] = True
                break

    return dp[n]


text = "ilikeicecream"
dictionary = ["i", "like", "ice", "cream", "icecream"]

if word_break(text, dictionary):
    print("String can be segmented")
else:
    print("String cannot be segmented")

